{
  "name": "our-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "photos:optimize": "node scripts/optimize-photos.mjs",
    "photos:upload": "node scripts/upload-photos.mjs",
    "dev": "node scripts/dev.mjs",
    "db:migrate:local": "wrangler d1 migrations apply our-web-db --local",
    "auth:set": "node scripts/set-password.mjs --remote",
    "auth:set:local": "node scripts/set-password.mjs --local",
    "db:migrate": "wrangler d1 migrations apply our-web-db --remote",
    "deploy": "wrangler pages deploy public --project-name our-web"
  },
  "devDependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.34.0",
    "wrangler": "^4.0.0"
  }
}
